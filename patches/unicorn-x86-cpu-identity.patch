-        /* XXX: exception? */
+        // Unicorn: see the write path above. Reading zero says the register is
+        // there; the hardware answer is a fault.
+        if (hooked == UC_MSR_DECLINED) {
+            raise_exception_err_ra(env, EXCP0D_GPF, 0, GETPC());
