+// Unicorn: run the UC_HOOK_INSN callbacks for an msr instruction. ANSWERED is
+// the contract CPUID and RDTSC use. DECLINED means hooks exist but none claimed
+// this register, so whoever registered them means it not to exist. UNHOOKED
+// keeps the fault below opt-in.
+//
+// No pc sync, unlike cpuid: these helpers are also reached from uc_reg_read of
+// UC_X86_REG_MSR, where GETPC() is an ordinary call's return address.
+#define UC_MSR_ANSWERED   1
+#define UC_MSR_DECLINED  -1
+#define UC_MSR_UNHOOKED   0
+
+static int uc_x86_msr_hooks(CPUX86State *env, int insn)
+{
+    uc_engine *uc = env->uc;
+    struct hook *hook;
+    int skip = 0;
+    int listening = 0;
+
+    HOOK_FOREACH_VAR_DECLARE;
+    HOOK_FOREACH(env->uc, hook, UC_HOOK_INSN) {
+        if (hook->to_delete)
+            continue;
+        if (!HOOK_BOUND_CHECK(hook, env->eip))
+            continue;
+
+        // Multiple msr callbacks returning different values is undefined.
+        if (hook->insn == insn) {
+            listening = 1;
+            JIT_CALLBACK_GUARD_VAR(skip, ((uc_cb_insn_cpuid_t)hook->callback)(env->uc, hook->user_data));
+        }
+
+        // the last callback may already have asked to stop emulation
+        if (env->uc->stop_request)
+            break;
+    }
+
+    if (skip) {
+        return UC_MSR_ANSWERED;
+    }
+
+    return listening ? UC_MSR_DECLINED : UC_MSR_UNHOOKED;
+}
+
 void helper_wrmsr(CPUX86State *env)
 {
     uint64_t val;
+    int hooked = uc_x86_msr_hooks(env, UC_X86_INS_WRMSR);
+
+    if (hooked == UC_MSR_ANSWERED) {
+        return;
+    }
 
     cpu_svm_check_intercept_param(env, SVM_EXIT_MSR, 1, GETPC());
 
@@ -323,6 +371,9 @@
         ((uint64_t)((uint32_t)env->regs[R_EDX]) << 32);
 
     switch ((uint32_t)env->regs[R_ECX]) {
+    case MSR_IA32_TSC:
+        env->tsc_offset = val - cpu_get_tsc(env);
+        break;
     case MSR_IA32_SYSENTER_CS:
         env->sysenter_cs = val & 0xffff;
         break;
@@ -468,7 +519,12 @@
             }
             break;
         }
-        /* XXX: exception? */
+        // Unicorn: an msr this cpu does not implement. Dropping it silently is
+        // what a guest probing for a hypervisor's msr space looks for, so fault
+        // as hardware does -- but only for an emulator that registered a hook.
+        if (hooked == UC_MSR_DECLINED) {
+            raise_exception_err_ra(env, EXCP0D_GPF, 0, GETPC());
+        }
         break;
     }
 }
